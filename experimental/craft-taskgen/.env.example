# Direct API calls and Harbor agents require these settings. Replace the example host.
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://gateway.example.com/v1

# Claude Code requires these settings. The SDK appends /v1/messages to this base URL.
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_BASE_URL=https://gateway.example.com

# LLM-judge steps can use a separate key, endpoint, and model.
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=
